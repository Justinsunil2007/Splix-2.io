# Required environment variables

## Game Server (Render.com)
# ─────────────────────────────────────────────────────────────
# The secret password for the tournament organizer admin panel.
# Must be set in Render dashboard. Never commit this to git.
ADMIN_SECRET=your_secure_admin_password_here

# The Vercel frontend URL for CORS (e.g. https://splix2io.vercel.app)
# Use * to allow all origins (easier but less secure)
CORS_ORIGIN=https://your-app.vercel.app

# Port (Render injects this automatically — do not set manually on Render)
PORT=8080

## Frontend (Vercel)
# ─────────────────────────────────────────────────────────────
# The public WSS URL of your Render game server
# Format: wss://YOUR-RENDER-APP-NAME.onrender.com
VITE_GAME_SERVER_URL=wss://splix2io-server.onrender.com
